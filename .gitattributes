# Store text with LF in the repo and check it out with LF everywhere
* text=auto eol=lf

# Windows scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary data — never touch
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.nc   binary
*.hdf  binary
*.h5   binary
*.tif  binary
*.tiff binary
